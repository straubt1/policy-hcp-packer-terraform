import "http"
import "json"

# Local variables for these functions
hcp_config = {}       # set with setHCPConfiguration()
hcp_access_token = "" # set with getHCPAuthToken()

# This function will seed all the HCP configuration parameters for easy access in future function calls
func setHCPConfiguration(hcp_client_id, hcp_client_secret, hcp_organization_id, hcp_project_id) {
	hcp_config = {
		"client_id":       hcp_client_id,
		"client_secret":   hcp_client_secret,
		"organization_id": hcp_organization_id,
		"project_id":      hcp_project_id,
	}
	return hcp_config
}

# Call the HCP authentication function to get the auth token
# https://developer.hashicorp.com/hcp/docs/hcp/api#authenticate-to-hcp
func getHCPAuthToken() {
	endpoint = "https://auth.idp.hashicorp.com/oauth2/token"
	request_body = "client_id=" + hcp_config.client_id +
		"&client_secret=" +
		hcp_config.client_secret +
		"&grant_type=client_credentials" +
		"&audience=https://api.hashicorp.cloud"

	req = http.request(endpoint).with_header("Content-Type", "application/x-www-form-urlencoded").with_body(request_body)
	response = http.post(req)

	# If a non 200 response is received, the policy fails automagically
	response_body = json.unmarshal(response.body)
	hcp_access_token = response_body.access_token
	return hcp_access_token
}

# This function handles pagination for the HCP API calls and is only called from other functions in this file.
# It recursively fetches all pages of results until no next_page_token is found.
# This is necessary because Sentinel does not support while loops.
func fetchAllPages(base_endpoint, property, next_page_token, all_pages) {
	# Update query parameters for pagination and sorting
	page_size = 100
	endpoint = base_endpoint +
		"?sorting.order_by=name" + # Sort by name for consistency
		"&pagination.page_size=" + # Set page size to reduce the number of API calls
		string(page_size)

	# If a next_page_token is provided, append it to the endpoint
	if next_page_token != "" {
		endpoint = endpoint + "&pagination.next_page_token=" + next_page_token
	}

	# Build the HTTP request with the necessary headers
	req = http.request(endpoint).with_header("Authorization", "Bearer " + hcp_access_token).with_header("Content-Type", "application/json").with_header("Accept", "application/json")

	# Make the HTTP GET request to the HCP API
	response = http.get(req)
	body = json.unmarshal(response.body)

	# Index the response body to get the property we are interested in
	# Most endpoints return a single property that contains the list of items, e.g., "buckets" or "versions"
	all_pages = all_pages + body[property]

	# If we have another page to fetch, recursively call this function
	if body.pagination is defined and body.pagination.next_page_token is defined and body.pagination.next_page_token != "" {
		return fetchAllPages(base_endpoint, property, body.pagination.next_page_token, all_pages)
	}

	# Return the accumulated pages through function recursion
	return all_pages
}

# Get all HCP Packer buckets of the given platform (AWS, Azure, GCP, etc.)
# https://developer.hashicorp.com/hcp/api-docs/packer#PackerService_ListBuckets
func getBucketsForPlatform(platform) {
	endpoint = "https://api.cloud.hashicorp.com/packer/2023-01-01/organizations/" +
		hcp_config.organization_id +
		"/projects/" +
		hcp_config.project_id +
		"/buckets"

	all_buckets = fetchAllPages(endpoint, "buckets", "", [])

	# Filter all_buckets for the platform
	buckets = filter all_buckets as bucket {
		any bucket.platforms as bucket_platform {
			bucket_platform is platform
		}
	}
	return buckets
}

# Attempt to find a specific image by its ID in all the buckets
# Once an image is found in a bucket, it returns the image(s) found in that bucket only.
# It is unlikely that an image ID will be found multiple times in the same bucket
# It is also unlikely that an image ID will be found in multiple buckets, but this function currently doesn't handle that case.
func getImageByImageId(buckets, image_id) {
	# Loop through each bucket to find the image ID
	image_versions = []
	for buckets as bucket {
		# print("Searching for image ID:", image_id, "in bucket:", bucket.name)
		endpoint = "https://api.cloud.hashicorp.com/packer/2023-01-01/organizations/" +
			hcp_config.organization_id +
			"/projects/" +
			hcp_config.project_id +
			"/buckets/" +
			bucket.name +
			"/versions"

		all_bucket_versions = fetchAllPages(endpoint, "versions", "", [])
		# print(all_bucket_versions)
		# req = http.request(endpoint).with_header("Authorization", "Bearer " + hcp_access_token).with_header("Content-Type", "application/json").with_header("Accept", "application/json")
		# response = http.get(req)
		# body = json.unmarshal(response.body)

		# Filter the versions/builds/artifacts to find the one with the specified image ID
		image_versions = filter all_bucket_versions as version {
			any version.builds as build {
				any build.artifacts as artifact {
					artifact.external_identifier is image_id
				}
			}
		}
		# if found, return all matches, let the policy decided what to do if there are multiple matches
		if length(image_versions) > 0 {
			# print("Found image ID:", image_id, "in bucket:", bucket.name)
			return image_versions
		}
	}
	return image_versions
}
