import "http"
import "json"

# Local variables for these functions
hcp_config = {}       # set with setHCPConfiguration()
hcp_access_token = "" # set with getHCPAuthToken()

# This function will seed all the HCP configuration parameters for easy access in future function calls
func setHCPConfiguration(hcp_client_id, hcp_client_secret, hcp_organization_id, hcp_project_id) {
	hcp_config = {
		"client_id":       hcp_client_id,
		"client_secret":   hcp_client_secret,
		"organization_id": hcp_organization_id,
		"project_id":      hcp_project_id,
	}
	return hcp_config
}

# Call the HCP authentication function to get the auth token
# https://developer.hashicorp.com/hcp/docs/hcp/api#authenticate-to-hcp
func getHCPAuthToken() {
	endpoint = "https://auth.idp.hashicorp.com/oauth2/token"
	request_body = "client_id=" + hcp_config.client_id +
		"&client_secret=" +
		hcp_config.client_secret +
		"&grant_type=client_credentials" +
		"&audience=https://api.hashicorp.cloud"

	req = http.request(endpoint).with_header("Content-Type", "application/x-www-form-urlencoded").with_body(request_body)
	response = http.post(req)

	# If a non 200 response is received, the policy fails automagically
	response_body = json.unmarshal(response.body)
	hcp_access_token = response_body.access_token
	return hcp_access_token
}

func getImageByExternalIdentifier(external_identifier) {
	endpoint = "https://api.cloud.hashicorp.com/packer/2023-01-01/organizations/" +
        hcp_config.organization_id +
        "/projects/" +
        hcp_config.project_id +
        "/_search/external_artifact"

	body = {
		"external_identifier": external_identifier,
	}

	# Build the HTTP request with the necessary headers
	req = http.request(endpoint).with_header("Authorization", "Bearer " + hcp_access_token).with_header("Content-Type", "application/json").with_header("Accept", "application/json").with_body(json.marshal(body))

	# Make the HTTP POST request to the HCP API
	response = http.post(req)
	return parseImageResponse(json.unmarshal(response.body), external_identifier)
}

# Convert the response to a more usable format for the policy to evaluate
# This will also handle when more than one artifact or build is found
func parseImageResponse(r, external_identifier) {
	if r == null {
		return {}
	}
	if r.artifacts == null {
		return {}
	}
	if length(r.artifacts) == 0 {
		return {}
	}
	# Check for uncommon cases and print a warning
	if length(r.artifacts) >1  {
		print("[WARNING]: More than one artifact found for the given external identifier. Returning the first one.")
	}

	artifact = r.artifacts[0]
	if length(artifact.build.artifacts) == 0 {
		print("[ERROR]: No build artifacts found for the given external identifier. Returning empty object.")
	}

	if length(artifact.build.artifacts) > 1{ 
		print("[WARNING]: More than one build artifact found for the given external identifier. Returning the first one.")
	}
	build_artifact = artifact.build.artifacts[0] 

	p = {	}
	p["external_identifier"] = external_identifier
	p["bucket"] = {
		"name": artifact.bucket.name,
		"id": artifact.bucket.id,
		"labels": artifact.bucket.labels,
	}
	p["build"] = {
		"id": artifact.build.id,
		"status": artifact.build.status,
		"platform": artifact.build.platform,
		"labels": artifact.build.labels,
	}
	p["version"] = {
		"name": artifact.version.name,
		"id": artifact.version.id,
		"status": artifact.version.status,
		"revocation_message": artifact.version.revocation_message,
		"revocation_author": artifact.version.revocation_author,
		"revoke_at": artifact.version.revoke_at,
	}
	p["artifact"] = {
		"id": build_artifact.id,
		"region": build_artifact.region,
		"created_at": build_artifact.created_at,
		"external_identifier": build_artifact.external_identifier,
	}

	return p
}

func printImageDetails(p) {
	# Safety Check
	if p is {} {
		return null
	}
	print("HCP Packer Image Details:")
	print("	external_identifier:", p.external_identifier)
	print("	bucket:", p.bucket.name, "(", p.bucket.id, ")")
	print("	bucket_labels:")
	for p.bucket.labels as key, value {
		print("	 ", key, ":", value)
	}
	print("	build:", p.build.id)
	print("	build_platform:", p.build.platform)
	print("	build_labels:")
	for p.build.labels as key, value {
		print("	 ", key, ":", value)
	}
	print("	build_status:", p.build.status)
	print("	version:", p.version.name)
	print("	version_status:", p.version.status)
	if p.version.revocation_message is not "" {
		print("	version_revocation_message:", p.version.revocation_message)
	}
	if p.version.revocation_author is not "" {
		print("	version_revocation_author:", p.version.revocation_author)
	}
	if p.version.revoke_at is not null {
		print("	version_revoke_at:", p.version.revoke_at)
	}
	return null
}
